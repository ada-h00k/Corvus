# Maintainer: ada-h00k
#
# Builds signal-cli Qt from a source tarball that sits next to this file.
# The release workflow creates it with `git archive`; to build locally:
#
#   pkgver=$(sed -n 's/^project(signal-cli-qt VERSION \([0-9.]*\).*/\1/p' CMakeLists.txt)
#   git archive --format=tar.gz --prefix="signal-cli-qt-$pkgver/" \
#       -o "packaging/arch/signal-cli-qt-$pkgver.tar.gz" HEAD
#   cd packaging/arch && makepkg -si
#
# (pkgver below must match the version used for the tarball name/prefix.)

pkgname=signal-cli-qt
pkgver=0.2.0
pkgrel=1
pkgdesc='Native Qt 6 GUI for signal-cli with an encrypted local chat history'
arch=('x86_64')
url='https://github.com/ada-h00k/signal-cli-Qt'
license=('AGPL-3.0-only')
depends=(
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-multimedia'
  'qtkeychain-qt6'
)
makedepends=(
  'cargo'
  'cmake'
  'ninja'
)
# signal-cli is not in the official repositories (AUR: signal-cli / signal-cli-bin),
# so it cannot be a hard dependency. The program needs it at runtime, though.
optdepends=(
  'signal-cli: required at runtime, install it from the AUR or as a release archive'
  'qrencode: show the QR code when linking a device'
  'pipewire: notification sounds via pw-play'
  'libpulse: notification sounds via paplay'
)
# LTO is already done by cargo (profile.release); keep GCC's LTO out of the
# link with the Rust static library. No separate -debug package.
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked \
    --target "$(rustc -vV | sed -n 's/^host: //p')" \
    --manifest-path history-store/Cargo.toml
}

build() {
  cd "$pkgname-$pkgver"
  # CMake invokes cargo for the Rust history store; keep it offline so it
  # only uses the crates fetched in prepare().
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_NET_OFFLINE=true

  cmake -S . -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  cd "$pkgname-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
