<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Wren</string>
    <key>CFBundleExecutable</key>
    <string>wren</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.wren.qt</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Wren</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@PROJECT_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@PROJECT_VERSION@</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.social-networking</string>
    <!--
      Files this app (and the signal-cli child process it starts) creates are marked
      as downloaded (com.apple.quarantine), so Gatekeeper checks them before they run.
      This covers received attachments and the temporary copies made by "Open".
    -->
    <key>LSFileQuarantineEnabled</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>AGPL-3.0 licensed. signal-cli is a separate program.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
