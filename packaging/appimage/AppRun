#!/bin/sh
# AppRun for the Corvus AppImage.
#
# corvus-cli and qrencode live in usr/bin next to the corvus executable. Corvus finds
# them through PATH and through its own directory, so usr/bin must be on PATH here.
# (Corvus removes every entry that points into the bundle again before it starts
# corvus-cli, see SignalCli::childEnvironment.)
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="${APPDIR:-$HERE}"

export PATH="$APPDIR/usr/bin:$PATH"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export QT_PLUGIN_PATH="$APPDIR/usr/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"

# Fonts: the host's fontconfig setup plus the emoji font that comes with the AppImage
# (see usr/etc/fonts/fonts.conf). A FONTCONFIG_FILE that is already set is left alone.
if [ -z "${FONTCONFIG_FILE:-}" ] && [ -r /etc/fonts/fonts.conf ] && [ -r "$APPDIR/usr/etc/fonts/fonts.conf" ]; then
    export FONTCONFIG_FILE="$APPDIR/usr/etc/fonts/fonts.conf"
fi

# (If linuxdeploy plugins add hooks, the AppRun that linuxdeploy generates sources
# apprun-hooks/*.sh first and then starts this script.)

exec "$APPDIR/usr/bin/corvus" "$@"
